                                                   title="<?= $rol->activo ? 'Desactivar' : 'Activar' ?>"
                                                   onclick="return confirm('¿Cambiar estado del rol?')">
                                                    <?= $rol->activo ? '🚫' : '✅' ?>
                                                </a>

                                                <?php
                                                $usuarios = (new Usuario())->count("rol = '{$rol->nombre}'");
                                                if ($usuarios == 0):
                                                    ?>
                                                    <a href="<?= PUBLIC_PATH ?>roles/eliminar/<?= $rol->id ?>"
                                                       class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                       onclick="return confirm('¿Eliminar rol permanentemente?')">
                                                        🗑️
                                                    </a>
