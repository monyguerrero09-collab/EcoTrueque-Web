                                        $usuario = (new Usuario())->count("rol = '{$rol->nombre}'");
                                        ?>
                                        <span class="badge bg-info"><?= $usuario ?> usuario</span>
                                    </td>
                                    <td>
                                        <?php if ($rol->activo): ?>
                                            <span class="badge bg-success">✅ Activo</span>
                                        <?php else: ?>
                                            <span class="badge bg-warning">⚠️ Inactivo</span>
