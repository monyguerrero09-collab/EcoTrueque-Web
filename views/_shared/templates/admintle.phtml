            color: #a2d36c;
            font-size: 1.8rem;
            transform: scale(0) rotate(-45deg);
            animation: growLogo 1.2s ease-out forwards;
        }

        @keyframes growLogo {
            0% { transform: scale(0) rotate(-45deg); opacity: 0; }
            60% { transform: scale(1.2) rotate(15deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }

        /* Navbar */
        .main-header.navbar {
            background-color: #43a047 !important;
            color: white;
            border-bottom: 3px solid #81c784;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .navbar a { color: white !important; }
        .navbar a:hover { color: #dcedc8 !important; }

        /* Sidebar */
        .main-sidebar {
            background: #343a40;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);
        }

        .nav-sidebar .nav-link p,
        .nav-sidebar .nav-link .nav-icon {
            color: #ffffff !important;
        }

        .nav-sidebar .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .brand-link {
            background-color: #27502a !important;
            color: #fff !important;
            font-weight: 700;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .content-wrapper {
            background-color: #fffdfd;
            border-radius: 15px;
            margin: 15px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
            border: none;
        }

        .card-header {
            background-color: #66bb6a;
            color: white;
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
            font-weight: bold;
        }

        .main-footer {
            background-color: #2e7d32;
            color: white;
            border-top: 3px solid #81c784;
        }

        .main-footer a { color: #c8e6c9; }
        .main-footer a:hover { color: #fff; }

        h1, h3 {
            color: #2e7d32;
            font-weight: 700;
        }

        /* --- MENÚ COLAPSADO --- */
        .sidebar-collapse .main-sidebar .nav-sidebar .nav-link p,
        .sidebar-collapse .user-panel,
