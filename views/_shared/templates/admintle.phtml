        }

        .sidebar-collapse .nav-sidebar .nav-link .nav-icon {
            background-color: #4b545c;
            color: #ffffff !important;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 !important;
            transition: background-color 0.3s ease;
        }

        .sidebar-collapse .nav-sidebar .nav-link {
            justify-content: center;
            padding: 0;
        }

        .sidebar-collapse .nav-sidebar .nav-item > .nav-link.active .nav-icon {
            background-color: #fbc02d;
            color: #333 !important;
        }

        .sidebar-collapse .nav-sidebar .nav-item:not(:has(> .nav-link.active)) > .nav-link:hover .nav-icon {
            background-color: #6c757d;
        }

        .sidebar-collapse .nav-sidebar .nav-link > .right {
