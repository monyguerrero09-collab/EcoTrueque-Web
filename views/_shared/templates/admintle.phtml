        /* ANIMACIÓN DE CARGA */
        #loader {
            position: fixed;
            inset: 0;
            background: linear-gradient(145deg, #e8f5e9, #a5d6a7);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            z-index: 9999;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }

        #loader.fade-out {
            opacity: 0;
            visibility: hidden;
        }

        .loader-leaf {
            font-size: 3rem;
            color: #26672b;
            animation: growLeaf 1.6s ease-in-out infinite alternate;
        }

        @keyframes growLeaf {
            0% { transform: scale(0.8) rotate(-10deg); opacity: 0.7; }
            100% { transform: scale(1.3) rotate(10deg); opacity: 1; }
        }

        .loader-text {
