<!-- 🌍 Script de Leaflet con geolocalización y reverse geocoding -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const latField = document.getElementById('latitud');
        const lngField = document.getElementById('longitud');
        const direccionInput = document.getElementById('direccion');
        const buscarBtn = document.getElementById('buscarDireccion');
        const direccionError = document.getElementById('direccionError');

        const defaultLat = <?= json_encode($trueque->latitud ?? 20.5937) ?>;
        const defaultLng = <?= json_encode($trueque->longitud ?? -100.3928) ?>;
        const startZoom = <?= ($trueque->latitud ?? false) ? 16 : 6 ?>;

        const map = L.map('map').setView([defaultLat, defaultLng], startZoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

        function updateMarker(latlng, zoom = null) {
            marker.setLatLng(latlng);
            if (zoom) map.setView(latlng, zoom);
            latField.value = latlng.lat;
            lngField.value = latlng.lng;

            // Reverse geocoding: llenar automáticamente el input de dirección
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latlng.lat}&lon=${latlng.lng}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.address) {
                        const parts = [
                            data.address.road || '',
                            data.address.suburb || '',
                            data.address.city || data.address.town || '',
                            data.address.state || ''
                        ].filter(Boolean);
                        direccionInput.value = parts.join(', ');
                    }
                })
                .catch(() => console.warn('No se pudo obtener la dirección'));
        }

        // GEOLOCALIZACIÓN AUTOMÁTICA
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const userLatLng = L.latLng(position.coords.latitude, position.coords.longitude);
                    updateMarker(userLatLng, 16);
                },
                function(error) {
                    console.warn('No se pudo obtener la ubicación del usuario: ' + error.message);
                }
            );
        }

        marker.on('dragend', e => updateMarker(e.target.getLatLng(), map.getZoom()));
        map.on('click', e => updateMarker(e.latlng, map.getZoom()));

        // Buscar dirección por texto
        function buscarDireccionFunc(address) {
            direccionError.textContent = '';
            if (!address) return;

            buscarBtn.disabled = true;
            buscarBtn.textContent = 'Buscando...';

            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1&countrycodes=mx`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        updateMarker(L.latLng(lat, lon), 16);
                    } else {
                        direccionError.textContent = 'No se encontró la dirección.';
                    }
                })
                .catch(() => direccionError.textContent = 'Error al conectar con el servicio.')
                .finally(() => {
                    buscarBtn.disabled = false;
                    buscarBtn.textContent = 'Buscar';
                });
        }

        buscarBtn.addEventListener('click', () => buscarDireccionFunc(direccionInput.value.trim()));
        direccionInput.addEventListener('keypress', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                buscarDireccionFunc(direccionInput.value.trim());
            }
        });
    });
</script>