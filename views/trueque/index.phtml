            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <?php Session::delete('valid'); ?>
    <?php endif; ?>

    <?php if (Session::get('error')): ?>
        <div class="alert alert-danger alert-dismissible fade show">
            <?= htmlspecialchars((string)Session::get('error'), ENT_QUOTES, 'UTF-8') ?>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <?php Session::delete('error'); ?>
    <?php endif; ?>

    <div class="row">
        <?php if (!empty($trueques)): ?>
            <?php foreach ($trueques as $trueque): ?>
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card h-100 position-relative">

                        <!-- ✅ Botón eliminar -->
                        <?php if ($usuario_actual === (int)$trueque->usuario_id): ?>
                            <div class="position-absolute top-0 end-0 p-2">
                                <a href="javascript:void(0);"
                                   onclick="confirmarEliminacion('<?= PUBLIC_PATH ?>trueque/eliminar/<?= (int)$trueque->id ?>')"
                                   class="btn btn-light btn-sm text-danger" title="Eliminar">🗑️</a>
                            </div>
                        <?php endif; ?>

                        <!-- ✅ Imagen -->
                        <?php if (!empty($trueque->imagen_mime) && !empty($trueque->imagen_base64)): ?>
                            <img src="data:<?= htmlspecialchars($trueque->imagen_mime) ?>;base64,<?= $trueque->imagen_base64 ?>"
                                 class="card-img-top" style="height:200px; object-fit:cover;">
                        <?php else: ?>
                            <img src="https://placehold.co/400x200" class="card-img-top" style="height:200px;">
                        <?php endif; ?>

                        <div class="card-body d-flex flex-column">

                            <!-- ✅ Usuario -->
                            <div class="d-flex align-items-center mb-2">
                                <?php if (!empty($trueque->usuario_avatar)): ?>
                                    <img src="<?= PUBLIC_PATH ?>img/avatars/<?= htmlspecialchars($trueque->usuario_avatar) ?>" class="avatar me-2">
                                <?php else: ?>
                                    <img src="https://placehold.co/100x100" class="avatar me-2">
                                <?php endif; ?>
                                <strong><?= htmlspecialchars($trueque->email ?? 'Usuario', ENT_QUOTES, 'UTF-8') ?></strong>
                            </div>

                            <p class="text-muted small">
                                <?= htmlspecialchars(substr((string)$trueque->descripcion, 0, 60)) ?>...
                            </p>

                            <h5 class="fw-bold text-center">
                                <?= htmlspecialchars($trueque->ofrezco) ?>
                            </h5>

                            <p class="text-center small text-secondary">
                                Intercambio por:<br>
                                <strong><?= htmlspecialchars($trueque->busco) ?></strong>
                            </p>

                            <?php if (!empty($trueque->direccion)): ?>
                                <p class="card-text small text-muted">
                                    📍 <?= htmlspecialchars($trueque->direccion) ?>
                                </p>
                            <?php endif; ?>

                            <div class="mt-auto d-grid gap-2">
                                <a href="<?= PUBLIC_PATH ?>trueque/ver/<?= (int)$trueque->id ?>" class="btn btn-outline-success btn-sm">
