                                </a>

                                <?php if ($usuario_actual && $usuario_actual !== (int)$trueque->usuario_id): ?>
                                    <a href="<?= PUBLIC_PATH ?>trueque/conversacion/<?= (int)$trueque->id ?>" class="btn btn-success btn-sm">
                                        💬 Chatear
                                    </a>
                                <?php endif; ?>
