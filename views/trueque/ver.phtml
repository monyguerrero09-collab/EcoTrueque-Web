        <?php if ($trueque->latitud && $trueque->longitud): ?>
            <div id="map" style="height:350px; border-radius:1rem;"></div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const map = L.map('map').setView(
                        [<?= $trueque->latitud ?>, <?= $trueque->longitud ?>], 15
                    );

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png')
                        .addTo(map);

                    L.marker([<?= $trueque->latitud ?>, <?= $trueque->longitud ?>])
                        .addTo(map)
                        .bindPopup("<?= htmlspecialchars($trueque->ofrezco) ?>");
                });
            </script>
        <?php endif; ?>

        <div class="text-center mt-4">
            <a href="<?= PUBLIC_PATH ?>trueque/index" class="btn btn-success">
                ⬅️ Regresar
            </a>

            <a href="<?= PUBLIC_PATH ?>trueque/conversacion/<?= $trueque->id ?>"
               class="btn btn-outline-success">
                💬 Abrir Chat
            </a>

            <button class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#modalMensaje">
                ✉️ Mensaje rápido
            </button>
        </div>

    </div>

    <!-- Modal -->
    <div class="modal fade" id="modalMensaje">
        <div class="modal-dialog">
            <div class="modal-content rounded-4">
                <form action="<?= PUBLIC_PATH ?>trueque/enviar_mensaje" method="POST">

                    <div class="modal-header">
                        <h5 class="modal-title">Enviar mensaje</h5>
                        <button class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="mensaje[trueque_id]" value="<?= $trueque->id ?>">
                        <input type="hidden" name="mensaje[destinatario_id]" value="<?= $trueque->usuario_id ?>">

                        <label class="form-label fw-bold">Mensaje:</label>
                        <textarea name="mensaje[mensaje]" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button class="btn btn-success">Enviar</button>
