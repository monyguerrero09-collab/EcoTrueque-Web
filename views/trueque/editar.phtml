<script>
    document.addEventListener('DOMContentLoaded', function () {

        // --- Mapa Leaflet ---
        const startLat = <?= json_encode($trueque->latitud ?? 20.5937) ?>;
        const startLng = <?= json_encode($trueque->longitud ?? -100.3928) ?>;
        const startZoom = <?= ($trueque->latitud) ? 16 : 6 ?>;

        const map = L.map('map').setView([startLat, startLng], startZoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const marker = L.marker([startLat, startLng], {draggable:true}).addTo(map);
        const latField = document.getElementById('latitud');
        const lngField = document.getElementById('longitud');

        function updateMarker(latlng, zoom){
            marker.setLatLng(latlng);
            if(zoom) map.setView(latlng, zoom);
            latField.value = latlng.lat;
            lngField.value = latlng.lng;
        }

        marker.on('dragend', e => updateMarker(e.target.getLatLng(), map.getZoom()));
        map.on('click', e => updateMarker(e.latlng, map.getZoom()));

        // --- Buscar dirección ---
        const buscarBtn = document.getElementById('buscarDireccion');
        const direccionInput = document.getElementById('direccion');
        const direccionError = document.getElementById('direccionError');

        buscarBtn.addEventListener('click', ()=>{
            const address = direccionInput.value.trim();
            if(!address) return;
            buscarBtn.disabled = true;
            buscarBtn.textContent = 'Buscando...';
            direccionError.textContent = '';

            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1&countrycodes=mx`)
                .then(res => res.json())
                .then(data=>{
                    if(data && data.length>0){
                        updateMarker(L.latLng(data[0].lat, data[0].lon),16);
                    }else{
                        direccionError.textContent = 'No se encontró la dirección.';
                    }
                })
                .catch(()=>direccionError.textContent='Error al conectar con el servicio.')
                .finally(()=>{
                    buscarBtn.disabled=false;
                    buscarBtn.textContent='Buscar';
                });
        });

        // --- Vista previa de imagen ---
        const inputImagen = document.getElementById('imagen_producto');
        const imagenPreview = document.getElementById('imagen_preview');
        inputImagen.addEventListener('change', event=>{
            const file = event.target.files[0];
            if(file){
                const reader = new FileReader();
                reader.onload = e => imagenPreview.src = e.target.result;
                reader.readAsDataURL(file);
            }
        });

    });
</script>





