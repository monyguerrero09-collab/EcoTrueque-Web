<?php View::content(); ?>

<style>
    .chat-box {
        display: flex;
        flex-direction: column;
        height: 500px;
        overflow-y: auto;
        background: #f0f2f5;
        padding: 15px;
        border-radius: 12px;
    }
    .msg {
        max-width: 70%;
        margin-bottom: 10px;
        padding: 12px 18px;
        border-radius: 20px;
        font-size: 14px;
    }
    .me {
        background: #0084ff;
        color: white;
        align-self: flex-end;
    }
    .other {
        background: #e4e6eb;
        color: black;
        align-self: flex-start;
    }
    .time {
        font-size: 11px;
        color: #666;
        margin-top: 5px;
    }
    .chat-input-area {
        display: flex;
        gap: 10px;
        padding: 12px;
        background: white;
        border-top: 1px solid #ddd;
