    textarea {
        flex: 1;
        border-radius: 20px;
        padding: 10px;
        resize: none;
    }
    .send-btn {
        background: #0084ff;
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: none;
        font-weight: bold;
    }
</style>

<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white fw-bold">
        💬 Conversación
    </div>

    <div id="chat" class="chat-box">
        <?php if (!empty($ultimos)): ?>
            <?php foreach ($ultimos as $m):
                $es_mio = ($m->remitente_id == $usuario_actual);
                ?>
                <div class="msg <?= $es_mio ? 'me' : 'other' ?>">
                    <?= nl2br(htmlspecialchars($m->mensaje)) ?>
                    <div class="time">
                        <?= date('d/m/Y H:i', strtotime($m->fecha_envio)) ?>
                    </div>
                </div>
            <?php endforeach; ?>
        <?php else: ?>
            <p class="text-center text-muted">No hay mensajes.</p>
        <?php endif; ?>
    </div>

    <form class="chat-input-area" action="<?= PUBLIC_PATH ?>trueque/enviar_mensaje" method="POST">
        <input type="hidden" name="mensaje[trueque_id]" value="<?= (int)$trueque->id ?>">
        <input type="hidden" name="mensaje[destinatario_id]" value="<?= (int)$trueque->usuario_id ?>">

        <textarea name="mensaje[mensaje]" placeholder="Escribe..." required></textarea>
        <button class="send-btn">➤</button>
    </form>
</div>

<script>
    const chat = document.getElementById("chat");
    chat.scrollTop = chat.scrollHeight;
</script>



