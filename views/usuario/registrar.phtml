<!-- Formulario de registro de usuario -->
<div class="container d-flex justify-content-center align-items-center vh-100" style="background: linear-gradient(135deg, #a8edea, #fed6e3);">
    <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width: 450px; border: none;">

        <!-- Encabezado con logo y título -->
        <div class="text-center mb-4">
            <img src="/img/greentec_logo.png" alt="EcoTrueque" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover;">
            <h3 class="fw-bold text-success mt-2">🌱 Crea tu Cuenta</h3>
            <p class="text-muted mb-0">Únete a la comunidad EcoTrueque</p>
        </div>

        <?php Flash::show('flash', false) ?>

        <?= Form::open() ?>

        <div class="form-floating mb-3">
            <?= Form::text('usuario.username', [
                'class' => 'form-control rounded-3',
                'id' => 'username',
                'placeholder' => 'Tu nombre de usuario',
                'required' => true
            ]) ?>
            <label for="username">👤 Nombre de Usuario</label>
        </div>

        <div class="form-floating mb-3">
            <?= Form::email('usuario.email', [
                'class' => 'form-control rounded-3',
                'id' => 'email',
                'placeholder' => 'ejemplo@correo.com',
                'required' => true
            ]) ?>
            <label for="email">📧 Correo Electrónico</label>
        </div>

        <div class="form-floating mb-3">
            <?= Form::pass('usuario.password', [
                'class' => 'form-control rounded-3',
                'id' => 'password',
                'placeholder' => 'Mínimo 6 caracteres',
                'required' => true,
                'minlength' => 6
            ]) ?>
            <label for="password">🔑 Contraseña</label>
        </div>

        <div class="form-floating mb-4">
            <?= Form::pass('usuario.password_confirm', [
                'class' => 'form-control rounded-3',
                'id' => 'password_confirm',
                'placeholder' => 'Confirma tu contraseña',
                'required' => true
            ]) ?>
            <label for="password_confirm">✅ Confirmar Contraseña</label>
        </div>

        <div class="d-grid mb-3">
            <?= Form::submit('✳️ Registrar Cuenta', [
                'class' => 'btn btn-success rounded-pill fw-bold py-2',
                'style' => 'border: none; background-color: #38a169;'
            ]) ?>
        </div>

        <?= Form::close() ?>

        <div class="text-center mt-3">
            <p class="text-muted mb-1">¿Ya tienes una cuenta?</p>
            <a href="<?= PUBLIC_PATH ?>session/index"
               class="btn btn-outline-success rounded-pill fw-bold py-2 w-100"
               style="border-color: #38a169; color: #38a169;">
                🚪 Inicia Sesión aquí
            </a>
        </div>
    </div>
</div>
